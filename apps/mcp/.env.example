# apps/mcp — Excalidraw MCP server
# Copy to .env and fill in values for local development.

# Node environment
NODE_ENV=development

# --- Checkpoint storage ---
# Controls where diagram checkpoints are persisted across tool calls.
# Options: "file" (local dev), "memory" (ephemeral), "redis" (Render/prod)
# Leave unset to auto-detect: uses Redis when MCP_REDIS_URL is set, otherwise
# file in development and memory in production.
MCP_CHECKPOINT_BACKEND=

# Optional: custom Redis key prefix (default: "notedraw:mcp:cp")
MCP_CHECKPOINT_PREFIX=notedraw:mcp:cp

# --- Redis checkpoint storage (required for MCP_CHECKPOINT_BACKEND=redis) ---
# Render Key Value / Redis URL (or any standard Redis URL accepted by ioredis)
MCP_REDIS_URL=

# --- Sentry error tracking ---
# Optional — set to capture MCP server errors in production
SENTRY_DSN=

# --- Optional webhook ---
# If set, the MCP server will POST share export events to this URL.
NOTEDRAW_SHARE_EXPORT_URL=
NOTEDRAW_SHARE_EXPORT_TOKEN=
