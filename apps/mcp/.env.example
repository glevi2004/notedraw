# apps/mcp — Excalidraw MCP server
# Copy to .env and fill in values for local development.

# Node environment
NODE_ENV=development

# --- Checkpoint storage ---
# Controls where diagram checkpoints are persisted across tool calls.
# Options: "file" (default for local dev), "memory" (ephemeral), "redis" (Vercel/production)
# Leave unset to auto-detect: uses Redis if KV env vars are set, otherwise memory.
MCP_CHECKPOINT_BACKEND=

# Optional: custom Redis key prefix (default: "notedraw:mcp:cp")
MCP_CHECKPOINT_PREFIX=notedraw:mcp:cp

# --- Upstash Redis (required for MCP_CHECKPOINT_BACKEND=redis) ---
# Use either the Vercel KV template variables OR the Upstash-native variables.
# Vercel KV (set automatically when you link a KV store in the Vercel dashboard):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash native (use these if not using Vercel KV):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional webhook ---
# If set, the MCP server will POST share export events to this URL.
NOTEDRAW_SHARE_EXPORT_URL=
NOTEDRAW_SHARE_EXPORT_TOKEN=
