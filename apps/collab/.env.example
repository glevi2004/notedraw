# apps/collab — Collaboration WebSocket server
# Copy to .env and fill in values for local development.

# Port to listen on (default: 4001)
PORT=4001

# Comma-separated list of allowed CORS origins.
# REQUIRED in production (the server will exit at startup if unset).
# In development, set to the Next.js dev server origin.
COLLAB_ALLOWED_ORIGINS=http://localhost:3000

# Optional: Redis URL for pub/sub when running multiple collab instances.
# Render Key Value / Redis works here (or any standard Redis URL accepted by ioredis).
# Omit to run in single-process mode (fine for development and small deployments).
COLLAB_REDIS_URL=

# Optional: maximum Socket.IO payload size in bytes (default: 1 000 000 = 1 MB)
COLLAB_MAX_PAYLOAD_BYTES=1000000

# Optional: maximum collab file upload size in bytes (default: 10 485 760 = 10 MB)
# This limit is enforced by the /api/collab/files route in apps/web, not here.
# COLLAB_MAX_FILE_BYTES=10485760

# --- Sentry error tracking ---
# Optional — set to capture errors and Socket.IO crashes in production
SENTRY_DSN=

# Node environment — affects startup validation (production requires COLLAB_ALLOWED_ORIGINS)
NODE_ENV=development
