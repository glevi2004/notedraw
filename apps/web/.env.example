# --- Database ---
# For Neon: use the *pooled* PgBouncer endpoint (port 6543) for the running app.
# Add ?pgbouncer=true&connection_limit=5 to avoid exhausting the pool across
# multiple Vercel serverless instances.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech:6543/neondb?pgbouncer=true&connection_limit=5&sslmode=require
# For Neon: use the *direct* connection (port 5432) for migrations only.
# Used by `db:migrate:deploy` and `db:migrate:status` — never in the running app.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech:5432/neondb?sslmode=require

# Optional: Vercel Postgres template variables
PGHOST=YOUR_PG_HOST
PGHOST_UNPOOLED=YOUR_PG_HOST_UNPOOLED
PGUSER=YOUR_PG_USER
PGDATABASE=YOUR_PG_DATABASE
PGPASSWORD=YOUR_PG_PASSWORD
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
POSTGRES_USER=YOUR_PG_USER
POSTGRES_HOST=YOUR_PG_HOST
POSTGRES_PASSWORD=YOUR_PG_PASSWORD
POSTGRES_DATABASE=YOUR_PG_DATABASE
POSTGRES_URL_NO_SSL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?connect_timeout=15&sslmode=require

# --- Clerk Auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Collab (client) ---
# URL of the collab websocket service
NEXT_PUBLIC_COLLAB_SERVER_URL=http://localhost:4001

# --- Collab service (apps/collab) ---
# Allowed origins for socket.io CORS (comma-separated)
COLLAB_ALLOWED_ORIGINS=http://localhost:3000
# Optional (required if running multiple collab instances)
COLLAB_REDIS_URL=redis://:password@host:6379/0
# Optional payload size cap (bytes)
COLLAB_MAX_PAYLOAD_BYTES=1000000

# --- Optional app tuning ---
SYNC_FULL_SCENE_INTERVAL_MS=20000

# --- Sentry error tracking ---
# DSN is intentionally public — it identifies the project, not a secret
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
# Private DSN alias used in server config (same value, keeps env consistent)
SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
# Org/project/token are only needed in CI for source map uploads
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=notedraw-web
SENTRY_AUTH_TOKEN=sntrys_...   # Generate at sentry.io → Settings → Auth Tokens

# --- AI / OpenRouter ---
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- Rate limiting (optional, override defaults) ---
# AI scene chat: default 20 req / 60s per user
AI_SCENE_CHAT_RATE_LIMIT_MAX=20
AI_SCENE_CHAT_RATE_LIMIT_WINDOW_MS=60000
# Scene save: default 60 req / 60s per user
RATE_LIMIT_SCENE_SAVE_MAX=60
RATE_LIMIT_SCENE_SAVE_WINDOW_MS=60000
# Share create: default 10 req / 60s per user
RATE_LIMIT_SHARE_CREATE_MAX=10
RATE_LIMIT_SHARE_CREATE_WINDOW_MS=60000
# Share read: default 200 req / 60s per user
RATE_LIMIT_SHARE_READ_MAX=200
RATE_LIMIT_SHARE_READ_WINDOW_MS=60000

# ⚠️  SECRETS CHECKLIST — verify before production deploy:
# The following MUST use Vercel encrypted env vars (never committed, never NEXT_PUBLIC_):
#   DATABASE_URL, DATABASE_URL_UNPOOLED, PGPASSWORD
#   CLERK_SECRET_KEY, CLERK_WEBHOOK_SECRET
#   BLOB_READ_WRITE_TOKEN
#   OPENROUTER_API_KEY
# The following are intentionally public (safe as NEXT_PUBLIC_):
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  — Clerk design: publishable key is client-safe
#   NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL  — just a URL path
#   NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL  — just a URL path
#   NEXT_PUBLIC_COLLAB_SERVER_URL  — WebSocket URL the browser needs to connect
